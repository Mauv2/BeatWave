{"tool":"execute_code","args":{"action":"execute","code":"var g=UnityEngine.Object.FindObjectOfType<BeatWave.Stage3.Stage3Gameplay>(); return g.GetComponentsInChildren<UnityEngine.SpriteRenderer>(true).Where(s=>s.GetComponentInParent<Note>()==null && s.sprite!=null && !UnityEditor.AssetDatabase.GetAssetPath(s.sprite).StartsWith(\"Assets/Stage3/Art/\")).Select(s=>new{name=s.name,path=UnityEditor.AssetDatabase.GetAssetPath(s.sprite),note=s.GetComponentInParent<Note>(true)!=null}).ToArray();"}}
